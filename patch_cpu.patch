+                const delta = Math.sqrt(finalDeltaSq);
+                if (delta > 0 && isFinite(delta)) {
+                  const si = iter - Math.log2(Math.log2(delta));
+                  if (!isNaN(si) && isFinite(si)) {
+                    finalT = Math.max(0, si);
